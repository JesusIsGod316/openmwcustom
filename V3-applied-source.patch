+        bool trySubmit(std::function<void()> task)
+        {
+            std::lock_guard lock(mMutex);
+            if (mBusy || mStop)
+                return false;
+            mTask = std::move(task);
+            mBusy = true;
+            mWork.notify_one();
+            return true;
+        }
+
+        void wait()
+        {
+            std::unique_lock lock(mMutex);
+            mDone.wait(lock, [this] { return !mBusy; });
