+        {
+            while (true)
+            {
+                std::function<void()> task;
+                {
+                    std::unique_lock lock(mMutex);
+                    mWork.wait(lock, [this] { return mStop || mBusy; });
+                    if (mStop)
+                        return;
+                    task = mTask;
+                }
+                task();
+                {
+                    std::lock_guard lock(mMutex);
+                    mTask = {};
+                    mBusy = false;
+                }
+                mDone.notify_all();
+            }
+        }
