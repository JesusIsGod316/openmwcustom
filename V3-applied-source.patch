+NVF4 GetInterpEdgeMap(const NVF4 edge[2][2], NVF phase_frac_x, NVF phase_frac_y)
+{
+    NVF4 h0 = lerp(edge[0][0], edge[0][1], phase_frac_x);
+    NVF4 h1 = lerp(edge[1][0], edge[1][1], phase_frac_x);
+    return lerp(h0, h1, phase_frac_y);
