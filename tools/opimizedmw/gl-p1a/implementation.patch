+# OpimizedMW GL-P1A: optional ownership pressure protection (OpenGL only).
+# Off is the existing P0 control. Does not change healthy cache TTL/counts.
+# Startup-only: changes take effect on the next launch; no live policy mutation.
+opimizedmw host pressure = false
+# MiB. 0 scales caution reserve to usable RAM / 8 (minimum 512 MiB).
+# Critical = half this reserve; recovery = 1.25 times reserve for five seconds.
+opimizedmw host reserve mb = 0
+# Independent process/system commit reserve, not a private-RAM usage cap.
+# Critical = 0.25 times this reserve; recovery = 1.5 times reserve.
+opimizedmw commit reserve mb = 1024
+
 # V3 RAM/cache policy preset.
 # normal = upstream OpenMW cache behavior.
 # aggressive = longer-lived caches for systems with spare RAM.
