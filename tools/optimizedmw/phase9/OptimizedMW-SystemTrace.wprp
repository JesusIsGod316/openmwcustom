<?xml version="1.0" encoding="utf-8"?>
<WindowsPerformanceRecorder Version="1.0" Author="OptimizedMW">
  <Profiles>
    <SystemCollector Id="SystemCollector" Name="OptimizedMW Scheduling and IO">
      <BufferSize Value="512" />
      <Buffers Value="512" />
    </SystemCollector>
    <EventCollector Id="EventCollector" Name="OptimizedMW GPU">
      <BufferSize Value="256" />
      <Buffers Value="256" />
    </EventCollector>
    <SystemProvider Id="SystemProvider">
      <Keywords>
        <Keyword Value="CpuConfig" /><Keyword Value="ProcessThread" /><Keyword Value="Loader" />
        <Keyword Value="CSwitch" /><Keyword Value="ReadyThread" /><Keyword Value="SampledProfile" />
        <Keyword Value="DiskIO" /><Keyword Value="DiskIOInit" /><Keyword Value="FileIO" /><Keyword Value="FileIOInit" />
        <Keyword Value="DPC" /><Keyword Value="Interrupt" /><Keyword Value="HardFaults" />
      </Keywords>
      <Stacks>
        <Stack Value="CSwitch" /><Stack Value="ReadyThread" /><Stack Value="SampledProfile" />
        <Stack Value="DiskReadInit" /><Stack Value="DiskWriteInit" /><Stack Value="PagefaultHard" />
      </Stacks>
    </SystemProvider>
    <EventProvider Id="DxgKrnl" Name="Microsoft-Windows-DxgKrnl" Level="5">
      <Keywords><Keyword Value="0x277" /></Keywords>
    </EventProvider>
    <Profile Id="OptimizedMW.Verbose.Memory" Name="OptimizedMW" Description="Scheduling, IO and GPU queues; circular 320 MiB buffers" LoggingMode="Memory" DetailLevel="Verbose">
      <Collectors>
        <SystemCollectorId Value="SystemCollector"><SystemProviderId Value="SystemProvider" /></SystemCollectorId>
        <EventCollectorId Value="EventCollector"><EventProviders><EventProviderId Value="DxgKrnl" /></EventProviders></EventCollectorId>
      </Collectors>
    </Profile>
  </Profiles>
</WindowsPerformanceRecorder>
