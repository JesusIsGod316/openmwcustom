--- a/src/lj_asm.c
+++ b/src/lj_asm.c
@@ -352,7 +352,9 @@ static void ra_dprintf(ASMState *as, const char *fmt, ...)
 #define ra_weak(as, r)		rset_set(as->weakset, (r))
