-#define ra_used(ir)		(ra_hasreg((ir)->r) || ra_hasspill((ir)->s))
+#define ra_used(ir)		(ra_hasreg((ir)->r) || \
+				 ((ir)->r != RID_SUNK && (ir)->r != RID_SINK && \
