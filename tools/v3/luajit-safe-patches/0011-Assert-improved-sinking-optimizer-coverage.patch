@@ -85,6 +152,11 @@ assert(p.leaf[1] == 1)
 assert(p.leaf[2] == 2)
 assert(p.leaf.tag == 20, p.leaf.tag)
 assert(p.fresh.n == 21, p.fresh.n)
+local traces, allocs, stores, heavy = sink_stats()
